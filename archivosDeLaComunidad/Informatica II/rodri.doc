#include <iostream>
#include <stdio.h>
using namespace std;


struct byte
{
unsigned a8:1;
unsigned a7:1;
unsigned a6:1;
unsigned a5:1;
unsigned a4:1;
unsigned a3:1;
unsigned a2:1;
unsigned a1:1;
};

union ent
{
int entero;
struct byte bit;
};


class isopo
{
private:
int ent1,ent2;
public:
isopo( int a, int b){ent1=a;ent2=b; };
void uni1 ();
void uni2 ();

};

void isopo :: uni1()
{
union ent watt;
watt.entero = ent1;
if( watt.bit.a4 == 1)
{ cout<<"El bit numero 4 esta activado";}
else
{ cout<<"El bit 4 no esta activado\n";}
}
void isopo :: uni2()
{
union ent newton;
newton.entero = ent2;
cout<<"\nEl numero original es: "<<newton.entero;
newton.bit.a6 = 1;
cout<<"\nEl numero despues de activar el bit 6 es: "<<newton.entero;
}

int main()
{
int a,b;
cout<<"Ingrese entero1 :";cin>>a;
cout<<"ingrese entero 2:";cin>>b;
class isopo casper(a,b);
casper.uni1();
casper.uni2();
return 0;
}
