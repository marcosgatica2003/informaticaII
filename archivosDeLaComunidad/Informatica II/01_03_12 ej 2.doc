#include <iostream>
using namespace std;
class vector{
		protected:
			int vec[2];
		public:
			friend void mult(class matriz);
			};
class matriz:public vector	{
			private:
				int matrix[2][2];
							
			public:
				void carga(void);
				friend void mult(class matriz);
							};
void matriz::carga(void)
{	cout<<"ingrese los valores del vector y la matrix\n";
	cout<<"VECTOR\n\n";
	for (int i = 0; i < 2; i++)
	{ 	
		cout<<"\nvalor"<<i<<"=\t";
		cin>>vec[i];
	}
	cout<<"\nMATRIX\n\n";
	for (int i = 0; i < 2; i++)
	{	for (int j = 0; j < 2; j++)
			{
				cout<<"\nvalor"<<i<<j<<"=\t";
				cin>>matrix[i][j];
			}
	
		
	}
}
void mult (class matriz m)
{ int res[2]={0,0};
	for (int i = 0; i < 2; i++)
	{	for (int j = 0; j < 2; j++)
		{
			res[i]=res[i]+m.matrix[i][j]*m.vec[i];
		}
	}
	cout<<"el Resultado es="<<endl;
	for (int i = 0; i < 2; i++)
	{
		cout<<res[i]<<"\t";
	}
}
	
int main(int argc, char **argv)
{	class matriz mat;
	
	mat.carga();
	mult(mat);
	return 0;
}

